# ---------------------------------------------------------------------------
# MathVision Parent-Notes — environment variables
# Copy to .env.local for local dev; set the same keys in the Vercel dashboard.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service-role key — SERVER ONLY. Used by the WhatsApp cron job to read due
# follow-ups across RLS. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (AI tidy & extract) -----------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional override. Defaults to the Haiku tier — plenty for tidying notes.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Granola (Path A: direct API import) -----------------------------------
# Requires a Granola Business/Enterprise plan. Leave blank to use paste-only.
GRANOLA_API_KEY=
GRANOLA_API_BASE=https://public-api.granola.ai

# --- WhatsApp via Twilio (self-nudge reminders) ----------------------------
# Twilio sandbox or live sender. Leave blank to keep reminders in-app only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender — Twilio sandbox is whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# The approved content template SID for the live sender (HX...). Optional on
# the sandbox, where free-form text works inside the 24h window.
TWILIO_WHATSAPP_TEMPLATE_SID=
# Number(s) that receive reminders + the periodic check-in, E.164. Separate
# multiple recipients with a comma (e.g. +6591234567,+6598765432). Can also be
# set per-account under Settings, which overrides this.
WHATSAPP_TO_NUMBER=

# --- WhatsApp two-way agent (chat to log / ask "what's pending") -----------
# Model for the WhatsApp assistant (tool-use agent). Defaults to Opus.
WHATSAPP_AGENT_MODEL=claude-opus-4-8
# Deepgram key for transcribing WhatsApp voice notes. Leave blank for text-only.
DEEPGRAM_API_KEY=
# Point the Twilio sandbox "When a message comes in" webhook (POST) at:
#   https://<your-app>/api/whatsapp/inbound
# Once that URL is final, set this to reject non-Twilio requests:
TWILIO_VALIDATE_SIGNATURE=false

# --- App URL (for links in WhatsApp messages) ------------------------------
# Your deployed URL, used in the "anything to log?" check-in deep link.
# On Vercel this falls back to the production URL automatically if unset.
APP_URL=

# --- Cron security ----------------------------------------------------------
# Shared secret guarding the /api/cron/whatsapp-reminders endpoint. Vercel Cron
# sends `Authorization: Bearer <CRON_SECRET>`. Generate a long random string.
CRON_SECRET=change-me-to-a-long-random-string
